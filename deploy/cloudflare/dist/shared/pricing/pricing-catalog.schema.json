{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasful.jp/schemas/pricing-catalog.schema.json",
  "title": "TASFUL Pricing Catalog",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "defaultCurrency", "skus"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "defaultCurrency": { "type": "string", "enum": ["JPY"] },
    "skus": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/skuEntry" }
    }
  },
  "$defs": {
    "billingType": {
      "type": "string",
      "enum": ["fixed", "percent", "subscription", "usage", "placeholder"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "planned"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daily": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
          }
        },
        "monthly": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "skuEntry": {
      "type": "object",
      "required": [
        "sku",
        "domain",
        "label",
        "description",
        "billingType",
        "currency",
        "provisional",
        "enabled",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "sku": { "type": "string", "minLength": 1 },
        "domain": {
          "type": "string",
          "enum": ["platform", "tasful_ai", "builder", "business_directory", "tlv"]
        },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "billingType": { "$ref": "#/$defs/billingType" },
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "enum": ["JPY"] },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "minimumAmount": { "type": "number", "minimum": 0 },
        "durationDays": { "type": "integer", "minimum": 1 },
        "provisional": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" },
        "stripePriceEnvKey": { "type": "string", "minLength": 1 },
        "limits": { "$ref": "#/$defs/limits" },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "billingType": { "const": "fixed" } } },
          "then": { "required": ["amount"] }
        },
        {
          "if": { "properties": { "billingType": { "const": "percent" } } },
          "then": { "required": ["percent", "minimumAmount"] }
        },
        {
          "if": { "properties": { "billingType": { "const": "subscription" } } },
          "then": { "required": ["amount"] }
        },
        {
          "if": { "properties": { "billingType": { "const": "placeholder" } } },
          "then": { "not": { "required": ["amount"] } }
        }
      ]
    }
  }
}
