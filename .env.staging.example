# Staging Supabase + TALK Voice Phase 2 — local template
# Copy to .env.staging (gitignored). Never commit real secrets.
# SSOT: docs/supabase-environments.md
# Manifest: reports/tasful-supabase-staging-project-manifest.json
# Generator: node scripts/lib/create-env-staging.mjs --help
#
# REQUIRED = must be non-empty Staging values before Staging execution
# OPTIONAL = may stay empty until needed
# Secrets: leave blank here; fill only in gitignored .env.staging / secret manager

# --- REQUIRED · Staging project (Dashboard → Settings → API) ---
SUPABASE_PROJECT_REF=ahlxuyvhzqdqaojiywmu
SUPABASE_URL=https://ahlxuyvhzqdqaojiywmu.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- REQUIRED · Production guard (scripts abort if CLI link equals this ref) ---
BD_PRODUCTION_PROJECT_REF=ddojquacsyqesrjhcvmn

# --- REQUIRED · 8788 / build:pages (inject chat-supabase-config.js for Staging) ---
TASFUL_SUPABASE_URL=https://ahlxuyvhzqdqaojiywmu.supabase.co
TASFUL_SUPABASE_ANON_KEY=

# --- REQUIRED · Staging-only issuer / audience / origin (no Production reuse) ---
TALK_VOICE_STAGING_HOSTNAME=127.0.0.1
TALK_VOICE_STAGING_ALLOWED_ORIGINS=http://127.0.0.1:8788
TALK_VOICE_STAGING_JWT_ISSUER=https://ahlxuyvhzqdqaojiywmu.supabase.co/auth/v1
TALK_VOICE_STAGING_JWT_AUDIENCE=authenticated

# --- REQUIRED · Feature flags (Staging execution; Production builds force false) ---
TALK_VOICE_SELF_HOSTED_TURN_ENABLED=false
TALK_VOICE_CONNECTION_TELEMETRY_ENABLED=false

# --- REQUIRED · TURN endpoints (Staging host only · no secrets in this file) ---
TALK_VOICE_TURN_HOST=
TALK_VOICE_TURN_UDP_PORT=3478
TALK_VOICE_TURN_TCP_PORT=3478
TALK_VOICE_TURN_TLS_PORT=443
TALK_VOICE_TURN_REALM=
TALK_VOICE_TURN_SHARED_SECRET=
TALK_VOICE_TURN_TLS_CERT_PATH=/run/secrets/talk_turn_fullchain.pem
TALK_VOICE_TURN_TLS_KEY_PATH=/run/secrets/talk_turn_privkey.pem

# --- REQUIRED · API / telemetry sinks (Staging or local 8788 only) ---
TALK_VOICE_TURN_CREDENTIAL_API_URL=http://127.0.0.1:8788/api/talk-voice-turn-credentials
TALK_VOICE_TELEMETRY_SINK=session_columns

# --- OPTIONAL · Auth / Stripe Test / SITE (Staging-only · never Production Live keys) ---
# AUTH_HOOK_L2_ALLOWLIST_PASSWORD=
# TALK_VOICE_TURN_FORCE_RELAY_TEST=false
# TALK_VOICE_TURN_CREDENTIAL_TTL_SEC=1200
# TALK_VOICE_TURN_EXTERNAL_IP=
# TALK_VOICE_TURN_RELAY_IP=
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_URL=http://127.0.0.1:8788

# Usage (PowerShell):
#   node scripts/lib/create-env-staging.mjs --dry-run
#   node scripts/lib/create-env-staging.mjs --force
#   # fill secrets from Staging Dashboard / secret manager (never log TURN shared secret)
#   node scripts/lib/create-env-staging.mjs --validate-only
#   node scripts/preflight-talk-voice-phase2-staging.mjs
