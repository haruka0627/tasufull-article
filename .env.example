# .env に ZEGO / DEEPSEEK 等
# Staging Supabase（service_role 含む）は .env.staging → dist/.dev.vars へ自動同期（P5-7c）
# 詳細: docs/supabase-environments.md · reports/platform-request-p5-7c-edge-secrets.md

# AI 運営秘書 — DeepSeek（サーバー側のみ · クライアントへ渡さない）
DEEPSEEK_API_KEY=
# 公式モデル: deepseek-v4-flash（既定）| deepseek-v4-pro
# deepseek-chat / deepseek-reasoner は 2026-07-24 廃止予定（設定しても v4-flash に正規化）
# DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# TASFUL AI — OpenRouter Limited PoC（Phase 6 · サーバー側のみ · Production 無効）
# 一般 UI / Auto Mode / プラン商品化には接続しない
# OPENROUTER_API_KEY=
# OPENROUTER_POC_ENABLED=false
# OPENROUTER_POC_HARNESS_TOKEN=
# OPENROUTER_POC_ALLOWLIST=
# （任意）OPENROUTER_CHAT_MODEL は使わない — allowlist 固定 2 slug のみ

# TLV Live ZEGO PoC（サーバー側のみ · Token 発行 API）
# ZEGOCLOUD Console → AppID / Server / ServerSecret（32 byte）
ZEGO_APP_ID=
ZEGO_SERVER=
ZEGO_SERVER_SECRET=

# Supabase（ビルド / 検証スクリプト用 · 既存）
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
